DATABASE_URL=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ENVIRONMENT=development
LOG_LEVEL=INFO
SSL_MODE=disable

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# JWT Configuration
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_SSL=true
REDIS_MAX_CONNECTIONS=10
REDIS_TIMEOUT=5

# Cache TTLs (in seconds)
CACHE_TTL_TOKEN=300  # 5 minutes
CACHE_TTL_USER=3600  # 1 hour
CACHE_TTL_FILE=1800  # 30 minutes

# AWS Lambda Configuration
AWS_LAMBDA_FUNCTION_NAME=fastapi-lambda-function
AWS_LAMBDA_FUNCTION_VERSION=1.0.0

# Email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@yourapp.com

# Password Reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password